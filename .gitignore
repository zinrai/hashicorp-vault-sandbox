/bin/

# Not committed, though in production root.crt may be: each sandbox makes
# its own CA. root.key never leaves the offline machine.
/*/ca/

# Not committed: node private keys.
/*/tls/

# Not committed: encrypted, but not public either.
/*/state/

# Not committed, though in production pubkeys/ is: each sandbox makes its
# own keys.
/*/pubkeys/
/sandbox/keyring/

# Not committed: the seal's credentials, the development seal's key, and
# the choice of seal, which differs from one sandbox to the next.
/workload/*.env
/workload/seal-key/
/.env
