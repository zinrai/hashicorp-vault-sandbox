# The load balancer's address too, not only the node's: it passes TLS
# through, so clients that connect to it see this certificate. By IP, not
# hostname: the nodes and the load balancer are reached by IP.
[req]
prompt             = no
distinguished_name = dn

[dn]
CN = foundation-vault-2

[node]
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = serverAuth
subjectAltName         = IP:172.28.0.12, IP:172.28.0.5
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
