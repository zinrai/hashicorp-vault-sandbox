# Sourced, not run, in this directory: it sets up the calling shell, and
# VAULT_CACERT is found from where it is sourced.
#
# The load balancer, not a node: the vault CLI must reach whichever node is
# active. vault-ceremony reads the cluster from the directory it runs in.
export VAULT_ADDR=https://172.28.0.5:8200
export VAULT_CACERT="$PWD/ca/root.crt"
# mkcert's CA in this cluster's directory, not the user's: each cluster
# has its own.
export CAROOT="$PWD/ca"
