# pathlen 0, not unlimited: the offline root CA signs node certificates
# only, never another CA.
[req]
prompt             = no
distinguished_name = dn
x509_extensions    = ca

[dn]
CN = foundation root CA

[ca]
basicConstraints     = critical, CA:TRUE, pathlen:0
keyUsage             = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash
