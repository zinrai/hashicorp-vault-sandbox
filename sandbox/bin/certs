#!/bin/bash
#
# The offline CA's work, in the cluster directory it is for: what each
# certificate says is in certs/, not here. Not for production: there it is
# done on an offline machine, and only the node certificates leave it.
#
# Issued once, not on every run: a node keeps its certificate until its
# directory under tls/ is removed, and the CA until ca/ is.

set -euo pipefail

key=(-newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes)

if [ ! -f ca/root.crt ]; then
  mkdir -p -m 0700 ca
  openssl req -x509 -quiet -config certs/ca.cnf "${key[@]}" -days 3650 \
    -keyout ca/root.key -out ca/root.crt
fi

for cnf in certs/nodes/*.cnf; do
  node=$(basename "$cnf" .cnf)
  [ -f "tls/$node/server.crt" ] && continue
  mkdir -p -m 0750 "tls/$node"
  openssl req -new -quiet -config "$cnf" "${key[@]}" -keyout "tls/$node/server.key" |
    openssl x509 -req -CA ca/root.crt -CAkey ca/root.key -days 730 \
      -extfile "$cnf" -extensions node -out "tls/$node/server.crt"
  cp ca/root.crt "tls/$node/ca.crt"
  # 0640, not 0600: the vault user reads the key through the group, as on a
  # host where the key is root:vault.
  chmod 0640 "tls/$node/server.key"
  echo "$node: tls/$node/"
done
